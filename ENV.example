# ============================================================
# Bii3 & Chri Online — environment template
# Copy to .env and fill real values. NEVER commit .env
# ============================================================

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
TRUST_PROXY=true
LOG_LEVEL=debug
SERVE_STATIC=false

# ---------- Database ----------
# Leave empty for ./data/bii3chri.db (SQLite, WAL mode)
DB_FILE=
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=

# ---------- Security (REQUIRED in production) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_COOKIE=bc_session
SESSION_DAYS=30
# Set to true when served over HTTPS
COOKIE_SECURE=false
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
RL_LOGIN=10
RL_REGISTER=6
RL_WRITE=60
RL_UPLOAD=40
RL_MESSAGE=40
RL_REPORT=10
RL_CONTACT=5

# ---------- Uploads ----------
UPLOAD_DIR=
UPLOAD_MAX_MB=8
UPLOAD_MAX_FILES=15

# ---------- Seed data ----------
SEED_DEMO=true
ADMIN_EMAIL=admin@bii3chri.ma
# Leave empty to let the seeder print a generated password once
ADMIN_PASSWORD=

# ---------- Moderation ----------
MODERATION_AUTO_APPROVE=false
MODERATION_BANNED_TERMS=سلاح,مخدرات,مسدس,armes,drogue

# ---------- Email (SMTP) ----------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bii3 & Chri Online <no-reply@bii3chri.ma>"
CONTACT_INBOX=support@bii3chri.ma

# ---------- SMS / OTP ----------
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=Bii3Chri

# ---------- Push notifications ----------
PUSH_ENABLED=false
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# ---------- Payments ----------
# none | cmi | stripe  (no real charge happens until configured & webhooks verified)
PAYMENT_PROVIDER=none
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
CMI_CALLBACK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
